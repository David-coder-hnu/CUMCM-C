# Claude Code 本地机器相关设置（不入库）
.claude/settings.local.json

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# MATLAB
*.asv

# Jupyter
.ipynb_checkpoints/

# 工具产生的临时文件（PDF 读取时渲染/提取的产物）
_extracted.txt
_page*.png

# Office 临时锁文件（Excel/Word 打开时自动生成）
~$*

# 数据/结果文件不忽略 —— PDF 与附件 xlsx 全部纳入版本控制

# 诊断脚本的中间产物（下划线前缀，可重跑生成）
代码/诊断/_*.npz
代码/诊断/_*.npy
代码/诊断/_*.log
代码/诊断/_*.xlsx
代码/诊断/_*.png
# 同上，但针对 _* 子目录（_pr1 等）；脚本本身仍入库
代码/诊断/_*/*.npz
代码/诊断/_*/*.npy
代码/诊断/_*/*.log
代码/诊断/_*/*.xlsx
代码/诊断/_*/*.png
